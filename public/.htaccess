# Dakter Achen - Sitemap & Clean SPA Route Configuration
# For Apache / cPanel / LiteSpeed web servers

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force serve XML sitemaps directly as application/xml without hitting WordPress
RewriteRule ^(sitemap\.xml|sitemap_index\.xml|wp-sitemap\.xml|post-sitemap\.xml|page-sitemap\.xml|category-sitemap\.xml|wp-sitemap-[a-z0-9-]+\.xml)$ $1 [L,T=application/xml]

# 2. Force serve robots.txt directly
RewriteRule ^robots\.txt$ robots.txt [L,T=text/plain]

# 3. Direct pass-through for WordPress WXR import
RewriteRule ^dakterachen-wordpress-import\.xml$ dakterachen-wordpress-import.xml [L,T=application/xml]

# 4. Clean URL SPA Routing (/blog/*, /specialty/*, /area/*, /doctor/*, /doctors)
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule . /index.html [L]
</IfModule>

# BEGIN WordPress Fallback
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress Fallback

